# SachiKheti Environment Variables Template

PORT=5000
NODE_ENV=production

# AWS RDS PostgreSQL Connection
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/sachikhetidb?schema=public&sslmode=prefer"

# JWT Secret
JWT_SECRET="generate_a_secure_random_string_here"
JWT_EXPIRES_IN="7d"

# Default Superadmin Credentials
ADMIN_USERNAME="SachiKhetiAdmin"
ADMIN_PASSWORD="Sachi@Kheti123"

# Business WhatsApp Phone (Include Country Code without + or spaces, e.g. 918295886832)
WHATSAPP_PHONE="918295886832"

# Razorpay Live / Test Keys
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_secret_..."
